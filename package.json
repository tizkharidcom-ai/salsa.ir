{
  "name": "westo",
  "version": "1.0.0",
  "private": true,
  "author": "WESTO",
  "main": "desktop/main.cjs",
  "description": "Local mirror of westo.local (Webflow + Three.js r161 + GSAP + Lenis) as design base for Westo",
  "scripts": {
    "start": "node server/server.js",
    "start:postgres": "node --env-file=.env.local server/server.js",
    "prototype": "node superadmin/frontend/server.js",
    "start:superadmin": "node superadmin/frontend/server.js",
    "start:superadmin:dev": "NODE_ENV=development node superadmin/frontend/server.js",
    "start:godmode": "node superadmin/frontend/server.js",
    "superadmin:control": "node server/salsa/control-plane/server.js",
    "superadmin:control:dev": "NODE_ENV=development node server/salsa/control-plane/server.js",
    "test:superadmin": "node superadmin/tests/run-all.js",
    "test:godmode": "node superadmin/tests/run-all.js",
    "smoke:salsa": "node scripts/salsa-runtime-smoke.js",
    "smoke:salsa:wiring": "node scripts/salsa-local-wiring-smoke.js",
    "smoke:salsa:tenants": "node scripts/salsa-pg-tenant-isolation-smoke.js",
    "smoke:salsa:tenant-infrastructure": "node --env-file=.env.local scripts/salsa-tenant-infrastructure-smoke.js",
    "smoke:salsa:tenant-infrastructure:real": "node scripts/salsa-tenant-infrastructure-real-smoke.js",
    "smoke:salsa:restart": "node scripts/salsa-pg-tenant-restart-check.js",
    "smoke:salsa:outbox": "node scripts/salsa-pg-outbox-multiworker-smoke.js",
    "smoke:salsa:backup-restore": "node scripts/salsa-pg-backup-restore-smoke.js",
    "smoke:salsa:pitr": "node scripts/salsa-pg-pitr-smoke.js",
    "smoke:salsa:minio": "node scripts/salsa-minio-object-storage-smoke.js",
    "salsa:production:gate": "node scripts/salsa-production-readiness-gate.js",
    "guard:truth": "node scripts/salsa-static-truth-guard.js",
    "salsa:control:inventory": "node scripts/extract-salsa-control-plane-routes.js",
    "salsa:openapi": "node scripts/generate-salsa-openapi.js",
    "salsa:body:gaps": "node scripts/generate-salsa-body-gap-inventory.js",
    "salsa:openapi:validate": "node scripts/validate-salsa-openapi.js",
    "smoke:salsa:backup-keys": "node scripts/salsa-backup-key-rotation-smoke.js",
    "smoke:salsa:edge-ledger": "node scripts/salsa-pg-edge-receipt-smoke.js",
    "smoke:salsa:capacity": "node scripts/salsa-capacity-smoke.js",
    "control:start": "node server/salsa/control-plane/server.js",
    "control:worker": "node server/salsa/control-plane/automation/worker.js",
    "salsa:control:migrate": "node server/salsa/control-plane/db/migration-runner.js",
    "start:full": "node server/full-stack.js",
    "test": "node scripts/salsa-runtime-smoke.js && node --env-file=.env.local scripts/vps-ecosystem-preflight.js",
    "migrate:postgres": "node server/migrate-postgres.js",
    "migrate:unified": "node server/migrate-unified-postgres.js",
    "migrate:unified:apply": "node server/migrate-unified-postgres.js --apply",
    "migrate:finance-v2": "node scripts/migrate-finance-v2-postgres.js",
    "migrate:finance-v2:apply": "node scripts/migrate-finance-v2-postgres.js --apply",
    "db:check": "node scripts/database-readiness-check.js",
    "db:check:json": "node scripts/database-readiness-check.js --json",
    "db:optimize": "node scripts/optimize-database.js",
    "db:optimize:apply-indexes": "node scripts/optimize-database.js --apply-indexes",
    "db:vacuum": "node scripts/optimize-database.js --vacuum",
    "postgres:up": "docker compose --env-file .env.local -f compose.finance-postgres.yml up -d --wait",
    "postgres:status": "docker compose --env-file .env.local -f compose.finance-postgres.yml ps",
    "postgres:stop": "docker compose --env-file .env.local -f compose.finance-postgres.yml stop",
    "postgres:migrate:plan": "node --env-file=.env.local scripts/migrate-finance-v2-postgres.js",
    "postgres:migrate:apply": "env WESTO_FINANCE_MIGRATION_CONFIRM=APPLY_FINANCE_SCHEMA node --env-file=.env.local scripts/migrate-finance-v2-postgres.js --apply",
    "postgres:backup": "node --env-file=.env.local scripts/backup-finance-v2-postgres.js",
    "postgres:seed-state": "node --env-file=.env.local server/migrate-postgres.js",
    "salsa:tenant:plan": "node scripts/salsa-tenant-plan.js",
    "salsa:tenant:plan:strict": "node scripts/salsa-tenant-plan.js --strict",
    "postgres:preflight": "node --env-file=.env.local scripts/finance-cutover-preflight.js",
    "verify:finance-v2-concurrency": "node scripts/verify-finance-v2-concurrency.js",
    "verify:finance-branch-scope": "node scripts/verify-finance-branch-scope.js",
    "audit:finance-v2": "node scripts/audit-finance-v2-migration.js",
    "preflight:finance-cutover": "node scripts/finance-cutover-preflight.js",
    "evidence:finance-cutover": "node scripts/finance-cutover-preflight.js --write-evidence",
    "perf:har": "node scripts/analyze-har.js",
    "images:previews": "node scripts/generate-menu-previews.js",
    "test:session-prewarm": "node scripts/test-session-prewarm.js",
    "test:static-bootstrap": "node scripts/test-static-bootstrap-fallback.js",
    "build:static-bootstrap": "node scripts/build-static-content-bootstrap.js",
    "seed:menu-foundation": "node scripts/seed-menu-foundation.js",
    "build:sites": "node scripts/build-sites-static.js",
    "build:smart": "node scripts/build-static-content-bootstrap.js && node scripts/build-smart-bundles.js && node scripts/build-three-postprocessing.js",
    "validate:smart": "node scripts/validate-smart-loading.js",
    "validate:pwa": "node scripts/validate-pwa-standalone.js",
    "validate:cleanup": "node scripts/validate-cleanup.js",
    "validate:admin": "node scripts/validate-admin-center.js",
    "validate:admin1000": "node scripts/validate-admin-1000.js",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder --mac --win",
    "desktop:dist:mac": "electron-builder --mac",
    "desktop:dist:win": "electron-builder --win"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ir.westo.admin",
    "productName": "WESTO Admin",
    "artifactName": "westo-admin-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist-desktop",
      "buildResources": "assets/icons"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/pwa-512.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/pwa-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WESTO Admin"
    }
  }
}
