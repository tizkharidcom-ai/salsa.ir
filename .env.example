# Copy this file to .env.local and replace both password placeholders with the
# same long, unique value. .env.local is ignored by git.
WESTO_POSTGRES_DB=westo
WESTO_POSTGRES_USER=westo_app
WESTO_POSTGRES_PASSWORD=replace-with-a-long-random-password
WESTO_POSTGRES_PORT=5433

DATABASE_URL=postgresql://westo_app:replace-with-a-long-random-password@127.0.0.1:5433/westo
DATABASE_SSL=false
WESTO_POSTGRES_REQUIRED=true
WESTO_JSON_RECOVERY_SNAPSHOT=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# SALSA tenant cell. Keep one release line and give every restaurant its own
# tenant identity and PostgreSQL database. These values are safe defaults for
# the Westo pilot; production cells should receive their own database URL.
SALSA_TENANT_ID=westo
SALSA_TENANT_SLUG=westo
SALSA_TENANT_NAME=کافه وستو
SALSA_CANONICAL_DOMAIN=westo.salsa.ir
SALSA_TENANT_HOSTS=westocoffee.ir,westo.salsa.ir
SALSA_CELL_ID=westo-cell-01
SALSA_RELEASE=local
SALSA_EDGE_MODE=true
SALSA_MULTI_TENANT_MODE=false
SALSA_ENFORCE_TENANT_HOST=false
SALSA_REQUIRE_TENANT_METADATA=false
SALSA_BRIDGE_ENABLED=true
# Keep false for the Iranian-only runtime policy. This is an explicit local
# development exception for foreign hosted APIs, never a production default.
SALSA_ALLOW_FOREIGN_RUNTIME=false
# SALSA_BRIDGE_URL=https://ops.salsa.ir/api/integrations/westo/events
# WESTO_SALSA_BRIDGE_SECRET=replace-with-a-dedicated-bridge-secret
# Control-plane only: 32-byte hex key for phone lookup/encryption. Never put
# this key in browser code or expose it through a tenant API.
# SALSA_CUSTOMER_DIRECTORY_KEY=replace-with-64-hex-characters

# Independent SALSA Control Plane. Never point this database at WESTO Finance's
# DATABASE_URL. Production requires all security values below from a secret
# manager; placeholders are intentionally invalid and must be replaced.
# SALSA_CONTROL_DATABASE_URL=postgresql://salsa_control:replace-with-a-long-random-password@127.0.0.1:55432/salsa_control_plane
# Tenant data-plane role: used for DDL/read/write inside the selected tenant DB.
# SALSA_TENANT_DB_POSTGRES_URL=postgresql://salsa_tenant_runtime:replace-with-a-long-random-password@127.0.0.1:55432/salsa_tenant_template
# Tenant lifecycle role: used only for CREATE/DROP/QUARANTINE DATABASE. It must
# use a different PostgreSQL role from SALSA_TENANT_DB_POSTGRES_URL.
# SALSA_TENANT_DB_ADMIN_URL=postgresql://salsa_tenant_admin:replace-with-a-long-random-password@127.0.0.1:55432/postgres
# Disposable D6 isolation smoke only; never set this for an unattended service.
# SALSA_TENANT_PG_SMOKE_CONFIRM=RUN_SALSA_TENANT_PG_ISOLATION_SMOKE
# Disposable D6 post-restart check only; supply exact tenant DB names after a
# controlled PostgreSQL restart and never set this for an unattended service.
# SALSA_TENANT_PG_RESTART_CONFIRM=RUN_SALSA_TENANT_PG_RESTART_CHECK
# SALSA_RESTART_DB_NAMES=tenant_example_a,tenant_example_b
# Disposable D7 two-worker PostgreSQL outbox smoke only; never set this for an
# unattended service. It verifies ACK/dedup, crash-window recovery, fencing and DLQ.
# SALSA_OUTBOX_SMOKE_CONFIRM=RUN_SALSA_OUTBOX_MULTIWORKER_SMOKE
# Disposable D8/D9-B backup/restore smoke only. It uses real pg_dump/pg_restore
# inside the exact disposable PostgreSQL container and deletes its artifacts.
# SALSA_PG_BACKUP_RESTORE_CONFIRM=RUN_SALSA_PG_BACKUP_RESTORE_SMOKE
# SALSA_BACKUP_SOURCE_TENANT_ID=tenant-example-a
# SALSA_BACKUP_SOURCE_DATABASE=tenant_example_a
# SALSA_BACKUP_PEER_DATABASE=tenant_example_b
# SALSA_PG_TOOL_DOCKER_CONTAINER=salsa-godmode-pg-backup-restore-smoke
# SALSA_CONTROL_PORT=3061
# SALSA_CONTROL_ALLOW_EPHEMERAL_DEV=false
# Enable the fail-closed Control DB resolver on the restaurant server only
# after the independent Control DB and tenant data base URLs are configured.
# SALSA_TENANT_CONTEXT_MODE=control-db
# SALSA_TRUST_PROXY=false
# Disposable one-tenant infrastructure smoke overrides (no app data import).
# SALSA_TENANT_DB_TEST_BASE_URL=postgresql://tenant_runtime:replace-with-a-long-random-password@127.0.0.1:5433/template
# SALSA_TENANT_DB_TEST_ADMIN_URL=postgresql://tenant_admin:replace-with-a-long-random-password@127.0.0.1:5433/postgres
# SALSA_TENANT_INFRA_SMOKE_ID=tenant-infra-smoke
# SALSA_SESSION_SECRET=replace-with-at-least-32-random-characters
# SALSA_BOOTSTRAP_SECRET=replace-with-at-least-16-random-characters
# SALSA_PII_KEYRING='{"v1":"replace-with-64-hex-characters"}'
# SALSA_MFA_ENCRYPTION_KEY=replace-with-64-hex-characters
# SALSA_EDGE_UPDATE_PUBLIC_KEY=replace-with-ed25519-public-key
# Optional verified Edge package staging root. In production this must be on
# an isolated volume owned by the Edge service; staging only writes an atomic
# pointer and never executes an untrusted package.
# SALSA_EDGE_PACKAGE_ARTIFACT_DIR=artifacts/salsa-edge-packages
# SALSA_GATEWAY_CALLBACK_SECRET=replace-with-at-least-16-random-characters
# SALSA_METRICS_TOKEN=replace-with-at-least-16-random-characters
# SALSA_INBOX_ACK_SECRET=replace-with-at-least-16-random-characters
# Optional external SIEM audit export. Production requires an HTTPS ingestion
# URL, a source identifier, and a secret of at least 32 characters supplied by
# the secret manager. Export is cursor-based and at-least-once; the receiver
# must honor the idempotency-key header. HTTP is permitted only in the explicit
# NODE_ENV=test test harness.
# SALSA_SIEM_INGEST_URL=https://siem.example.ir/api/v1/events
# SALSA_SIEM_SOURCE_ID=salsa-control-plane-cell-teh-01
# SALSA_SIEM_HMAC_SECRET=replace-with-at-least-32-random-characters
# SALSA_SIEM_ALLOW_INSECURE_TEST_ENDPOINT=false
# SALSA_AUTOMATION_ENABLED=false
# SALSA_AUTOMATION_INTERVAL_MS=5000
# Standalone supervised worker entrypoint: `npm run control:worker`. It shares
# the same Control Plane database and readiness gate as `control:start`; never
# run it with automation disabled or against the WESTO Finance database.
# SALSA_SESSION_TTL_HOURS=12
# SALSA_MAX_LOGIN_ATTEMPTS=5
# SALSA_LOCKOUT_MINUTES=15
# SALSA_SESSION_CLEANUP_INTERVAL_MS=300000
# SALSA_BRIDGE_TIMESTAMP_TOLERANCE_MS=300000

# Iranian payment gateway contract. Production requires a real provider
# credential and HTTPS endpoint; the paths must match the provider's native
# request/verify/refund API contract and are not fake fallback URLs.
# SALSA_GATEWAY_ZARINPAL_MERCHANT=replace-with-provider-credential
# SALSA_GATEWAY_ZARINPAL_BASE_URL=https://replace-with-provider-endpoint
# SALSA_GATEWAY_ZARINPAL_REQUEST_PATH=/request
# SALSA_GATEWAY_ZARINPAL_VERIFY_PATH=/verify
# SALSA_GATEWAY_ZARINPAL_REFUND_PATH=/refund
# SALSA_GATEWAY_SAMAN_TERMINAL=replace-with-provider-credential
# SALSA_GATEWAY_SAMAN_BASE_URL=https://replace-with-provider-endpoint
# SALSA_GATEWAY_SADAD_TERMINAL=replace-with-provider-credential
# SALSA_GATEWAY_SADAD_BASE_URL=https://replace-with-provider-endpoint
# SALSA_GATEWAY_MELLAT_TERMINAL=replace-with-provider-credential
# SALSA_GATEWAY_MELLAT_BASE_URL=https://replace-with-provider-endpoint
# SALSA_GATEWAY_TIMEOUT_MS=15000

# Optional local artifact-backed SALSA disaster-recovery store. Both values are
# required together; the key/keyring must be supplied by a secret manager in
# real deployments and must never be committed or exposed to the console.
# SALSA_BACKUP_ARTIFACT_DIR=artifacts/salsa-backups
# SALSA_BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters
# Preferred rotation-ready form: each value is a 32-byte hex key. Keep the
# previous key during re-encryption and remove it only after all manifests have
# been verified and escrow/recovery evidence has been recorded.
# SALSA_BACKUP_KEYRING='{"v1":"replace-with-64-hex-characters","v2":"replace-with-64-hex-characters"}'
# SALSA_BACKUP_ACTIVE_KEY_ID=v2
# Preferred production destination: an independent HTTPS S3-compatible object
# store. The Control Plane uploads only encrypted envelopes; credentials come
# from the secret manager. Do not set the insecure-localhost flag in production.
# SALSA_BACKUP_OBJECT_STORAGE_ENDPOINT=https://objects.example.ir
# SALSA_BACKUP_OBJECT_STORAGE_BUCKET=salsa-backups
# SALSA_BACKUP_OBJECT_STORAGE_ACCESS_KEY=replace-with-write-only-access-key
# SALSA_BACKUP_OBJECT_STORAGE_SECRET_KEY=replace-with-secret-manager-value
# SALSA_BACKUP_OBJECT_STORAGE_REGION=ir-thr-1
# SALSA_BACKUP_OBJECT_STORAGE_PREFIX=salsa-backups
# SALSA_BACKUP_OBJECT_STORAGE_ALLOW_INSECURE_LOCALHOST=false
# SALSA_SESSION_CLEANUP_INTERVAL_MS=300000

# In a production tenant cell, set these to true/false as a pair only after
# the database-per-tenant migration and restore drill have passed:
# SALSA_MULTI_TENANT_MODE=true
# SALSA_ENFORCE_TENANT_HOST=true
# SALSA_REQUIRE_TENANT_METADATA=true
# WESTO_JSON_RECOVERY_SNAPSHOT=false

# Required as an operator-supplied backup/audit reference when a pending
# Finance V2 migration is applied. Existing applied migrations need no value.
# WESTO_FINANCE_BACKUP_REFERENCE=backup-2026-09-01T00:00Z
# WESTO_FINANCE_BACKUP_DIR=artifacts/finance-v2/postgres-backups
# WESTO_PG_DUMP_BIN=pg_dump
# For the bundled local Docker PostgreSQL, set this instead:
# WESTO_PG_DUMP_DOCKER_CONTAINER=westo-postgres
