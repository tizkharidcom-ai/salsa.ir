    },
    {
      "path": "server/payment-attempt-transitions.js",
      "legacyPath": "server/payment-attempt-transitions.js",
      "layer": "server"
    },
    {
      "path": "server/payment-provider-status.js",
      "legacyPath": "server/payment-provider-status.js",
      "layer": "server"
    },
    {
      "path": "server/settlement-amounts.js",
      "legacyPath": "server/settlement-amounts.js",
      "layer": "server"
    },
    {
      "path": "server/settlement-in-flight-key.js",
      "legacyPath": "server/settlement-in-flight-key.js",
      "layer": "server"
    },
    {
      "path": "server/settlement-persistence-gate.js",
      "legacyPath": "server/settlement-persistence-gate.js",
      "layer": "server"
    },
    {
      "path": "server/settlement-reference.js",
      "legacyPath": "server/settlement-reference.js",
      "layer": "server"
    }
  ],
  "httpRoutes": [
    {
      "id": "post-068",
      "method": "POST",
      "paths": [
        "/api/payments/webhook/:provider"
      ],
