# Caddyfile.production
# سامانه پروکسی معکوس و صدور خودکار On-Demand TLS پلتفرم سالسا (SALSA Platform)
# معماری تک‌سرور متمرکز VPS با تفکیک کامل ساب‌دامین‌ها و دامنه‌های اختصاصی مشتریان

{
  # تنظیمات عمومی سرور
  email admin@salsa.ir

  # صدور خودکار و بی‌درنگ گواهی SSL برای دامنه‌های اختصاصی مشتریان (On-Demand TLS)
  # وب‌سرور برای هر دامنه جدید ابتدا اندپوینت ask را استعلام می‌کند تا از صدور برای دامنه‌های غیرمجاز جلوگیری کند.
  on_demand_tls {
    ask http://127.0.0.1:3061/api/control/infra/domains/tls-check
    interval 2m
    burst 5
  }

  # فشرده‌سازی سراسری
  order encode before file_server
}

# ==============================================================================
# ۱. دامنه اصلی و پیشخوان مدیریت پلتفرم سالسا (Control Plane & Godmode)
# ==============================================================================
salsa.ir, www.salsa.ir, admin.salsa.ir {
  encode gzip zstd

  # هدرهای امنیتی
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    X-Permitted-Cross-Domain-Policies "none"
    Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none';"
  }

  # APIهای مرکزی کنترل‌پلن پلتفرم (پورت ۳۰۶۱)
  handle /api/* {
    reverse_proxy 127.0.0.1:3061 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
    }
  }

  # وب‌سوکت‌های همگام‌سازی و تلمتری
  handle /socket.io/* {
    reverse_proxy 127.0.0.1:3061 {
      header_up Upgrade {>Upgrade}
      header_up Connection "upgrade"
    }
  }

  # رابط کاربری گادمود و پیشخوان مدیریتی پلتفرم (پورت ۳۰۵۰)
  handle {
    reverse_proxy 127.0.0.1:3050 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
    }
  }
}

# ==============================================================================
# ۲. ساب‌دامین‌های پیش‌فرض مشتریان پلتفرم (*.salsa.ir)
# مثال: westo.salsa.ir, shandiz.salsa.ir, shila.salsa.ir
# ==============================================================================
*.salsa.ir {
  encode gzip zstd

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  # هدایت مستقیم به وب‌اپلیکیشن رستوران (پورت ۴۱۸۰)
  # میان‌افزار Express بر اساس ساب‌دامین، هویت مشتری و تم مربوطه را لود می‌کند.
  reverse_proxy 127.0.0.1:4180 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}

    # پشتیبانی کامل از وب‌سوکت POS و KDS
    header_up Upgrade {>Upgrade}
    header_up Connection {>Connection}
  }
}

# ==============================================================================
# ۳. دامنه‌های اختصاصی مشتریان (Custom Domain BYOD / White-label)
# مثال: order.shandiz.com, westocoffee.ir
# گواهی SSL به صورت خودکار با On-Demand TLS و تأیید کنترل‌پلن صادر می‌شود.
# ==============================================================================
:443 {
  tls {
    on_demand
  }

  encode gzip zstd

  # ایزولاسیون کامل وایت‌لیبل (بدون افشای نام سرور یا پلتفرم)
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy 127.0.0.1:4180 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}

    # انتقال هدرهای وب‌سوکت
    header_up Upgrade {>Upgrade}
    header_up Connection {>Connection}
  }
}
