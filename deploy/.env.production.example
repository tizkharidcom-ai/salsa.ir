# ==============================================================================
# SALSA & WESTO Ecosystem Production Environment Variables Template
# ==============================================================================
# Copy this file to .env.production on your VPS:
#   cp deploy/.env.production.example /opt/westo/.env.production
#   chmod 600 /opt/westo/.env.production
# ==============================================================================

# Node Environment
NODE_ENV=production

# Service Listening Ports (Local Loopback bindings behind Nginx reverse proxy)
PORT=4180
GODMODE_PORT=3050
GODMODE_HOST=127.0.0.1
SALSA_CONTROL_PORT=3061

# Canonical Tenant Configuration
SALSA_TENANT_ID=westo
NEEM_TENANT_ID=westo

# Server-to-Server Live Bridge Security
# Generate a strong 64-char hex key: openssl rand -hex 32
WESTO_SALSA_BRIDGE_SECRET=replace_with_64_char_random_hex_secret
WESTO_NEEM_BRIDGE_SECRET=replace_with_64_char_random_hex_secret
SALSA_CONTROL_SECRET=replace_with_64_char_random_hex_secret

# Live Bridge Activation
SALSA_BRIDGE_ENABLED=true
NEEM_BRIDGE_ENABLED=true
SALSA_BRIDGE_URL=http://127.0.0.1:3061/api/control/integrations/westo/events

# Production Database Connections (PostgreSQL on VPS)
DATABASE_URL=postgresql://salsa_admin:replace-with-a-long-random-password@127.0.0.1:5432/salsa_production

# Encryption Keyrings for PII & MFA (JSON v1 format)
SALSA_PII_KEYRING={"v1":"replace_with_32_byte_hex_key_here"}
SALSA_MFA_ENCRYPTION_KEY=replace_with_32_byte_hex_key_here
SALSA_SESSION_SECRET=replace_with_64_char_random_hex_session_secret

# Platform Admin Credentials (for first-time God Mode login)
SALSA_SUPERADMIN_PHONE=09120000000
SALSA_SUPERADMIN_NAME="مدیر ارشد پلتفرم سالسا"

# Public Domains
WESTO_PUBLIC_DOMAIN=https://westo.ir
SALSA_PUBLIC_DOMAIN=https://salsa.westo.ir
